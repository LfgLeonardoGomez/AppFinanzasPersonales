# Variables para docker-compose.yml (nivel raíz del proyecto)
# Copiar a .env y ajustar según entorno.

# Base de datos
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=facturas_db
DB_PORT=5432

# Puertos expuestos en el host
API_PORT=8000
WEB_PORT=5173

# Rate limit del endpoint de extracción IA (debe matchear facturas-proveedores-api/.env.example)
IA_RATE_MAX_REQUESTS=60
IA_RATE_WINDOW_SECONDS=3600