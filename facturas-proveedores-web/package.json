{
  "name": "facturas-proveedores-web",
  "version": "0.1.0",
  "private": true,
  "description": "PWA para gestión de facturas de proveedores",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "generate-types": "openapi-typescript http://localhost:8000/openapi.json -o src/shared/api/api.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-dialog": "^1.1.19",
    "@tanstack/react-query": "^5.45.1",
    "@tanstack/react-query-devtools": "^5.45.1",
    "axios": "^1.7.2",
    "lucide-react": "^1.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "sonner": "^1.7.4",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@tailwindcss/vite": "^4.0.0-alpha.20",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^9.12.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "jsdom": "^24.1.0",
    "msw": "^2.3.4",
    "openapi-typescript": "^7.3.0",
    "tailwindcss": "^4.0.0-alpha.20",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.3.4",
    "vite-plugin-pwa": "^0.20.1",
    "vitest": "^1.6.0"
  }
}
