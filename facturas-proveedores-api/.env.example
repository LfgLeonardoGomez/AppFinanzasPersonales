# ============================================================
# Variables de entorno — facturas-proveedores-api
# Copiar este archivo a .env y completar los valores reales.
# NUNCA commitear .env con secretos.
# ============================================================

# Base de datos PostgreSQL
# Formato: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://postgres:changeme@localhost:5432/facturas_db

# Clave secreta para firmar tokens JWT (mín. 32 chars aleatorios)
SECRET_KEY=replace-with-a-strong-random-secret-key

# Cloudinary (para subida de archivos firmada)
# Obtener en: https://cloudinary.com/console
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Proveedor de visión IA para extracción de facturas/pagos
# Opciones: claude | openai
VISION_PROVIDER=claude

# Claves de APIs de visión (completar según VISION_PROVIDER)
ANTHROPIC_API_KEY=sk-ant-replace-me
OPENAI_API_KEY=sk-replace-me

# TTL del access token (en minutos)
# Recomendado: 30 para producción
ACCESS_TOKEN_TTL_MIN=30

# TTL del refresh token (en días)
# Recomendado: 30 para producción
REFRESH_TOKEN_TTL_DAYS=30

# Origen del frontend (para CORS con credentials:true)
# Ejemplo local: http://localhost:5173
# Ejemplo prod: https://facturas.midominio.com
FRONTEND_ORIGIN=http://localhost:5173

# Dominio para la cookie de sesión
# Ejemplo local: localhost
# Ejemplo prod: .midominio.com
COOKIE_DOMAIN=localhost

# ============================================================
# PRERREQUISITOS DE DESARROLLO
# - Docker Desktop corriendo (necesario para testcontainers y
#   docker compose up)
# - Python 3.11+
# - Node 20+
# ============================================================
