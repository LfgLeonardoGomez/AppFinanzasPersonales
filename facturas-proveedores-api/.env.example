# ============================================================
# Variables de entorno — facturas-proveedores-api
# Copiar este archivo a .env y completar los valores reales.
# NUNCA commitear .env con secretos.
# ============================================================

# Base de datos PostgreSQL
# Formato: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://postgres:changeme@localhost:5432/facturas_db

# Clave secreta para firmar tokens JWT (mín. 32 chars aleatorios)
SECRET_KEY=replace-with-a-strong-random-secret-key

# Cloudinary (para subida de archivos firmada)
# Obtener en: https://cloudinary.com/console
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Proveedor de visión IA para extracción de facturas/pagos
# Opciones: claude | openai | gemini
VISION_PROVIDER=claude

# Claves de APIs de visión (completar según VISION_PROVIDER)
ANTHROPIC_API_KEY=sk-ant-replace-me
OPENAI_API_KEY=sk-replace-me
GEMINI_API_KEY=replace-me

# Modelo de visión de Gemini (solo si VISION_PROVIDER=gemini)
# Default 'gemini-flash-latest' (tiene free tier).
# Alternativas: gemini-2.0-flash, gemini-flash-lite-latest
GEMINI_MODEL=gemini-flash-latest

# TTL del access token (en minutos)
# Recomendado: 30 para producción
ACCESS_TOKEN_TTL_MIN=30

# TTL del refresh token (en días)
# Recomendado: 30 para producción
REFRESH_TOKEN_TTL_DAYS=30

# Origen del frontend (para CORS con credentials:true)
# Ejemplo local: http://localhost:5173
# Ejemplo prod: https://facturas.midominio.com
FRONTEND_ORIGIN=http://localhost:5173

# Dominio para la cookie de sesión
# Ejemplo local: localhost
# Ejemplo prod: .midominio.com
COOKIE_DOMAIN=localhost


# ============================================================
# Correo transaccional (recuperación de contraseña)
# ============================================================

# Proveedor de envío de correo. Opciones: console | smtp
# 'console' (default) NO envía nada: imprime el link de recuperación
# en los logs del contenedor. Es el valor correcto en desarrollo.
# Con 'smtp', las variables SMTP_HOST / SMTP_USER / SMTP_PASSWORD /
# SMTP_FROM pasan a ser OBLIGATORIAS: si falta alguna, la API no
# arranca (falla al iniciar en vez de dejar de enviar en silencio).
EMAIL_PROVIDER=console

# Servidor SMTP. Ejemplo Gmail: smtp.gmail.com
SMTP_HOST=smtp.midominio.com

# Puerto SMTP. 587 con starttls (default), 465 con ssl.
SMTP_PORT=587

# Usuario SMTP (habitualmente la casilla completa).
SMTP_USER=no-reply@midominio.com

# Contraseña o API key SMTP.
# Con Gmail: usar un "app password" de 16 caracteres, NUNCA la
# contraseña de la cuenta.
SMTP_PASSWORD=replace-me

# Remitente del correo. Admite "Nombre <casilla@dominio.com>".
SMTP_FROM=no-reply@midominio.com

# Modo de cifrado. Opciones: starttls (puerto 587) | ssl (puerto 465).
# Nunca se envía en texto plano.
SMTP_SECURITY=starttls

# Timeout de la conexión SMTP, en segundos (evita colgar un worker).
SMTP_TIMEOUT_S=10

# Vida del token de recuperación, en minutos.
RESET_TOKEN_TTL_MIN=60

# Tope de tokens de recuperación vivos a la vez por cuenta.
RESET_TOKENS_PENDIENTES_MAX=3


IA_RATE_MAX_REQUESTS=60
IA_RATE_WINDOW_SECONDS=3600



# ============================================================
# PRERREQUISITOS DE DESARROLLO
# - Docker Desktop corriendo (necesario para testcontainers y
#   docker compose up)
# - Python 3.11+
# - Node 20+
# ============================================================
